# ffmpeg compress / convert
# Compress video with VAAPI hardware acceleration for AMD (23x)
<Multi_key> <c> <v> : "ffmpeg -init_hw_device vaapi=va:/dev/dri/renderD128 -filter_hw_device va -i INPUT.mp4 -vf 'format=nv12,hwupload' -c:v h264_vaapi -qp 28 -c:a copy OUTPUT.mp4"
# Compress video with VAAPI hardware acceleration (18x)
<Multi_key> <c> <V> : "ffmpeg -hwaccel vaapi -vf 'format=nv12,hwupload' -hwaccel_output_format vaapi -i INPUT.mp4 -c:v h264_vaapi -qp 28 -c:a copy OUTPUT.mp4"
# Compress video (less) (CPU)
<Multi_key> <c> <l> : "ffmpeg -i INPUT.mp4 -c:v libx264 -crf 33 -preset medium -c:a copy OUTPUT.mp4"
# Compress MP3
<Multi_key> <c> <a> : "ffmpeg -i INPUT.mp3 -map 0:a:0 -b:a 96k OUTPUT.mp3"
# Variable to constant bit-rate MP3
<Multi_key> <c> <B> : "ffmpeg -i INPUT.flac -c:a libmp3lame -b:a 128k OUTPUT_cbr.mp3"
