#!/usr/bin/env bash

# ---------------------------------------
# | todo. Interactive todo list manager |
# ---------------------------------------

TODO_DIR="${TODO_DIR:-$HOME/.todos}"

# Helper functions --.

# You'll need a nerd-icons font too!
todo_requires() {
  if ! command -v gum &>/dev/null; then
    echo -e "error: 'gum' is not installed.\nInstall it with: pacman -S gum\n" >&2
    return 1
  fi
}

todo_pick_file() {
  mkdir -p "$TODO_DIR"
  local new_opt choice f
  local -a files=()

  # Glob expansion is already collated, the names come out sorted
  local nullglob_was=1
  shopt -q nullglob || nullglob_was=0
  shopt -s nullglob

  for f in "$TODO_DIR"/*.md; do
    [[ -f "$f" ]] || continue # a directory named "….md", or a dangling symlink

    f="${f##*/}"
    files+=("${f%.md}")
  done

  (( nullglob_was )) || shopt -u nullglob

  new_opt="+ New list…"

  choice=$(printf '%s\n' "${files[@]}" "$new_opt" |
    gum choose --header "Todo lists:")

  [[ -z "$choice" ]] && return 1 # user cancelled

  if [[ "$choice" == "$new_opt" ]]; then
    choice=$(gum input --placeholder "List name (e.g. work, shopping)")
    [[ -z "$choice" ]] && return 1

    if [[ "$choice" == */* ]]; then
      gum style --foreground="#F38BA8" "List names can't contain '/'."
      sleep 1
      return 1
    fi
  fi

  printf '%s\n' "$TODO_DIR/${choice}.md"
}

# One pattern for every item line
# Captured as: indent, marker (including the space after it), state character, label
# Everything that reads or rewrites a line goes through it, so a hand-written "* [X] foo" is understood the same way everywhere and keept as is when written back
TODO_ITEM_RE='^([[:space:]]*)([-*+][[:space:]]\[(.?)\][[:space:]])(.*)$'

todo_is_item()    { [[ "$1" =~ $TODO_ITEM_RE ]]; }

todo_is_checked() { [[ "$1" =~ $TODO_ITEM_RE && "${BASH_REMATCH[3]}" == [xX] ]]; }

todo_is_blank()   { [[ -z "${1//[[:space:]]/}" ]]; }

# Sets TODO_LEVEL instead of printing it: todo_show calls this once per line on every redraw, a command substitution there costs a fork per item
todo_level() {
  local ws="${1%%[![:space:]]*}"
  ws=${ws//$'\t'/  } # a tab indents one level, like two spaces

  TODO_LEVEL=$(( ${#ws} / 2 ))
}

todo_label() {
  if [[ "$1" =~ $TODO_ITEM_RE ]]; then
    printf '%s\n' "${BASH_REMATCH[4]}"
  else
    printf '%s\n' "$1"
  fi
}

# Everything before the label, e.g. "  - [x] "
todo_prefix() {
  [[ "$1" =~ $TODO_ITEM_RE ]] && printf '%s\n' "${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
}

# Rewrite an item with a new state character, leaving its indent, marker and label exactly as they were
todo_set_checked() {
  local line="$1" state="$2"

  if [[ ! "$line" =~ $TODO_ITEM_RE ]]; then
    printf '%s\n' "$line"
    return
  fi

  local indent="${BASH_REMATCH[1]}" marker="${BASH_REMATCH[2]}" label="${BASH_REMATCH[4]}"

  printf '%s\n' "${indent}${marker:0:2}[${state}]${marker: -1}${label}"
}

# Swap a rebuilt list into place
# mktemp files are 0600, so mode is carried over, and a symlinked list should be written through, not replaced
todo_replace_file() {
  local tmp="$1" file="$2"

  [[ -L "$file" ]] && file=$(readlink -f "$file")
  [[ -e "$file" ]] && chmod --reference="$file" "$tmp" 2>/dev/null

  mv "$tmp" "$file"
}

# Menu stand-in for a blank line in the file
# A single space renders as an empty row in gum, but is still non-empty, so it can be told apart from the empty string gum returns when the user cancels.
TODO_MENU_SEP=" "

# The list is redrawn on every pass through the action menu, so todo_show writes it in one printf
# These are the same as the gum calls elsewhere use, as 24-bit escapes
TODO_C_RESET=$'\e[0m'
TODO_C_ITALIC=$'\e[3m'
TODO_C_ITEM=$'\e[38;2;205;214;244m' # #CDD6F4, still to do
TODO_C_MUTED=$'\e[38;2;153;156;169m' # #999ca9, completed
TODO_C_PROSE=$'\e[1;38;2;137;220;235m' # #89DCEB bold, headings and rules

# Sets TODO_BULLET, for the same reason as todo_level
# Matches the item pattern again, so callers must read anything they need out of BASH_REMATCH first
todo_bullet() {
  local line="$1" level="$2"

  if todo_is_checked "$line"; then
    TODO_BULLET="󰄵"
    (( level > 0 )) && TODO_BULLET="󰄴"
    (( level > 1 )) && TODO_BULLET="󰘾"
  else
    TODO_BULLET="󰄱"
    (( level > 0 )) && TODO_BULLET="󰄰"
    (( level > 1 )) && TODO_BULLET="󰘼"
  fi
}

# Build the entries for an item picker: every todo item, plus the headings and blank separators around them
# The grouping the user sees in the list is the grouping they see in the menu; those context rows are still selectable (gum has no inert rows), so they get index -1 and callers must ignore them
# usage: todo_build_menu <raw_lines_var> <display_var> <indices_var> [bullets]
todo_build_menu() {
  local -n _raw="$1" _display="$2" _indices="$3"
  local bullets="${4:-1}"

  _display=()
  _indices=()

  local -A seen=()
  local last_kind="" i

  for i in "${!_raw[@]}"; do
    local line="${_raw[$i]}"
    local row idx

    if todo_is_item "$line"; then
      local level pad=""
      todo_level "$line"
      level="$TODO_LEVEL"

      for ((j = 0; j < level; j++)); do pad+="  "; done

      local label
      label=$(todo_label "$line")

      if [[ "$bullets" -eq 1 ]]; then
        todo_bullet "$line" "$level"
        row="${pad}${TODO_BULLET} ${label}"
      else
        row="${pad}${label}"
      fi

      idx="$i"
      last_kind="item"
    elif todo_is_blank "$line"; then
      # Never lead with a separator and collapse runs of blank lines
      [[ -z "$last_kind" || "$last_kind" == "separator" ]] && continue

      _display+=("$TODO_MENU_SEP")
      _indices+=(-1)
      last_kind="separator"
      continue
    else
      # Heading (or any other prose line), kept as-is for user orientation
      row="$line"
      idx=-1
      last_kind="heading"
    fi

    # A row is only ever identified by the text gum hands back, so two items reading the same have to be told apart on screen
    # We add "… (n)" to the item's name, starting from 2
    if [[ -n "${seen["$row"]:-}" ]]; then
      local copy=$(( seen["$row"] + 1 ))

      while [[ -n "${seen["$row ($copy)"]:-}" ]]; do (( copy++ )); done

      seen["$row"]="$copy"
      row="$row ($copy)"
    fi

    seen["$row"]=1
    _display+=("$row")
    _indices+=("$idx")
  done

  # Drop context rows that trail the last item: they lead nowhere
  while (( ${#_indices[@]} > 0 )) && (( ${_indices[-1]} < 0 )); do
    unset '_display[-1]' '_indices[-1]'
  done
}

# True when a menu built by todo_build_menu holds at least one real item
todo_menu_has_items() {
  local -n _idx="$1"
  local i

  for i in "${_idx[@]}"; do
    (( i >= 0 )) && return 0
  done

  return 1
}

todo_add_items() {
  local file="$1"

  gum style --foreground="#A6E3A1" --bold "Add items (empty line to stop)"

  local first=1

  while true; do
    local item
    item=$(gum input --placeholder "New todo…" --width 90)
    [[ -z "$item" ]] && break

    # A hand-edited file may not end in a newline; appending to it as-is would glue the first new item onto the last existing one
    if (( first )); then
      [[ -s "$file" && -n "$(tail -c 1 "$file")" ]] && printf '\n' >>"$file"
      first=0
    fi

    printf '%s\n' "- [ ] $item" >>"$file"
    gum style --foreground="#999ca9" "  ✓ added: $item"
  done
}

todo_add_sub_items() {
  local file="$1"
  local -a raw_lines
  mapfile -t raw_lines <"$file"

  # Collect all items (not just top-level) as potential parents
  local -a parent_labels parent_indices
  todo_build_menu raw_lines parent_labels parent_indices 0

  if ! todo_menu_has_items parent_indices; then
    gum style --foreground="#F38BA8" "No items to nest under."
    sleep 1
    return
  fi

  local parent_label
  parent_label=$(printf '%s\n' "${parent_labels[@]}" |
    gum choose --header "Nest under parent:")
  [[ -z "$parent_label" ]] && return

  # Resolve chosen parent to a raw_lines index (a separator resolves to none)
  local parent_idx=-1

  for i in "${!parent_labels[@]}"; do
    if (( ${parent_indices[$i]} >= 0 )) && [[ "${parent_labels[$i]}" == "$parent_label" ]]; then
      parent_idx="${parent_indices[$i]}"
      break
    fi
  done

  [[ $parent_idx -lt 0 ]] && return

  # Collect new sub-items
  local -a new_items
  local parent_level
  todo_level "${raw_lines[$parent_idx]}"
  parent_level="$TODO_LEVEL"

  local child_indent=""
  for ((i = 0; i <= parent_level; i++)); do child_indent+="  "; done

  gum style --foreground="#A6E3A1" --bold "Add sub-items under '$(todo_label "${raw_lines[$parent_idx]}")' (empty line to stop)"
  while true; do
    local item
    item=$(gum input --placeholder "New sub-todo…" --width 90)

    [[ -z "$item" ]] && break

    new_items+=("$item")
    gum style --foreground="#999ca9" "  ✓ added: $item"
  done

  [[ ${#new_items[@]} -eq 0 ]] && return

  # Find insertion point: after the parent's existing child block
  local n=${#raw_lines[@]}
  local insert_at=$n

  for ((k = parent_idx + 1; k < n; k++)); do
    if todo_is_item "${raw_lines[$k]}"; then
      todo_level "${raw_lines[$k]}"

      if (( TODO_LEVEL <= parent_level )); then
        insert_at=$k
        break
      fi
    fi
  done

  # Rewind past anything that isn't an item (blank separators, headings) so the new sub-items land right after the parent's last child, rather than on the far side of the blank line that closes the group
  while (( insert_at > parent_idx + 1 )) && ! todo_is_item "${raw_lines[$((insert_at - 1))]}"; do
    (( insert_at-- ))
  done

  # A fresh sub-item leaves the branch above it unfinished, this makes every checked ancestor go back to undone
  # Walking outwards one level at a time skips siblings and cousins, which are not affected
  local level_above=$(( parent_level + 1 ))

  for ((k = parent_idx; k >= 0; k--)); do
    todo_is_item "${raw_lines[$k]}" || continue

    todo_level "${raw_lines[$k]}"
    (( TODO_LEVEL < level_above )) || continue
    level_above="$TODO_LEVEL"

    todo_is_checked "${raw_lines[$k]}" \
      && raw_lines[k]=$(todo_set_checked "${raw_lines[$k]}" " ")

    (( level_above == 0 )) && break
  done

  # Rebuild file with new items inserted at the right position
  local tmp
  tmp=$(mktemp)

  {
    for ((i = 0; i < insert_at; i++)); do printf '%s\n' "${raw_lines[$i]}"; done

    for item in "${new_items[@]}"; do printf '%s\n' "${child_indent}- [ ] ${item}"; done

    for ((i = insert_at; i < n; i++)); do printf '%s\n' "${raw_lines[$i]}"; done
  } >"$tmp"

  todo_replace_file "$tmp" "$file"
}

todo_toggle_items() {
  local file="$1"
  [[ ! -s "$file" ]] && gum style --foreground="#F38BA8" "List is empty." && return

  local -a raw_lines
  mapfile -t raw_lines <"$file"

  # Track actual todo items with their file line index, plus separators
  local -a item_display item_indices
  todo_build_menu raw_lines item_display item_indices

  todo_menu_has_items item_indices || { gum style --foreground="#F38BA8" "No items yet."; return; }

  local chosen
  chosen=$(printf '%s\n' "${item_display[@]}" |
    gum choose --no-limit \
      --header "Space to toggle · Enter to confirm · Esc to cancel" \
      --height 20)

  [[ -z "$chosen" ]] && return

  # Match on the display text gum hands back (todo_build_menu keeps it unique)
  local n=${#raw_lines[@]}
  # picked = the user's own choices
  # target = the state each line ends up in
  local -a picked target

  for i in "${!raw_lines[@]}"; do picked[i]=0; target[i]=-1; done

  for j in "${!item_display[@]}"; do
    local idx="${item_indices[$j]}"

    (( idx < 0 )) && continue # separator or heading

    if [[ $'\n'"$chosen"$'\n' == *$'\n'"${item_display[$j]}"$'\n'* ]]; then
      picked[idx]=1
      todo_is_checked "${raw_lines[$idx]}" && target[idx]=0 || target[idx]=1
    fi
  done

  # Children follow the state their parent was just given
  for j in "${!item_indices[@]}"; do
    local i="${item_indices[$j]}"

    (( i < 0 )) && continue # separator or heading
    (( picked[i] == 1 )) || continue

    local parent_level
    todo_level "${raw_lines[$i]}"
    parent_level="$TODO_LEVEL"

    for ((k = i + 1; k < n; k++)); do
      todo_is_item "${raw_lines[$k]}" || continue

      todo_level "${raw_lines[$k]}"

      (( TODO_LEVEL > parent_level )) || break

      # An explicit pick of its own wins over the parent's cascade
      (( picked[k] == 1 )) || target[k]="${target[$i]}"
    done
  done

  # Write updated file
  local tmp
  tmp=$(mktemp)

  for i in "${!raw_lines[@]}"; do
    case "${target[$i]}" in
    1) todo_set_checked "${raw_lines[$i]}" "x" ;;
    0) todo_set_checked "${raw_lines[$i]}" " " ;;
    *) printf '%s\n' "${raw_lines[$i]}" ;;
    esac
  done >"$tmp"

  todo_replace_file "$tmp" "$file"
}

todo_show() {
  local file="$1"
  local name
  name=$(basename "$file" .md)

  gum style \
    --border rounded \
    --border-foreground="#89B4FA" \
    --padding "0 2" \
    --bold \
    --foreground="#CDD6F4" \
    "$name"

  echo ""

  if [[ ! -s "$file" ]]; then
    printf '%s  No items yet.%s\n\n' "${TODO_C_ITALIC}${TODO_C_MUTED}" "$TODO_C_RESET"
    return
  fi

  local -a rows=()
  local line

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ $TODO_ITEM_RE ]]; then
      # Read out of BASH_REMATCH before anything else matches over it
      local state="${BASH_REMATCH[3]}" label="${BASH_REMATCH[4]}"

      todo_level "$line"
      todo_bullet "$line" "$TODO_LEVEL"

      local pad=""
      for ((i = 0; i < TODO_LEVEL; i++)); do pad+="  "; done

      local color="$TODO_C_ITEM"
      [[ "$state" == [xX] ]] && color="$TODO_C_MUTED"

      rows+=("${color} ${pad}${TODO_BULLET} ${label}${TODO_C_RESET}")
    elif todo_is_blank "$line"; then
      rows+=("") # no point coloring nothing
    else
      # Headings, rules and any other prose, kept verbatim
      rows+=("${TODO_C_PROSE}${line}${TODO_C_RESET}")
    fi
  done <"$file"

  printf '%s\n' "${rows[@]}"
  echo ""
}

todo_clear_completed() {
  local file="$1"

  local -a raw_lines
  mapfile -t raw_lines <"$file"

  local n=${#raw_lines[@]}

  local -a skip
  for i in "${!raw_lines[@]}"; do skip[i]=0; done

  local removed=0

  for i in "${!raw_lines[@]}"; do
    local line="${raw_lines[$i]}"

    if todo_is_checked "$line"; then
      skip[i]=1
      (( removed++ ))
      # Also skip all children, regardless of their state
      local parent_level
      todo_level "$line"
      parent_level="$TODO_LEVEL"

      for ((k = i + 1; k < n; k++)); do
        if todo_is_item "${raw_lines[$k]}"; then
          todo_level "${raw_lines[$k]}"

          (( TODO_LEVEL > parent_level )) \
            && skip[k]=1 || break
        fi
      done
    fi
  done

  if (( removed == 0 )); then
    gum style --foreground="#999ca9" "Nothing completed to clear."
    gum spin --title "…" sleep 0.5
    return
  fi

  local tmp
  tmp=$(mktemp)

  # Removing a block tends to strand the blank line that used to separate it
  # The surviving lines are written back with blank runs collapsed
  local pending_blank=0 wrote=0

  for i in "${!raw_lines[@]}"; do
    [[ "${skip[$i]}" -eq 1 ]] && continue

    if todo_is_blank "${raw_lines[$i]}"; then
      (( wrote == 1 )) && pending_blank=1
      continue
    fi

    (( pending_blank == 1 )) && printf '\n'
    pending_blank=0
    wrote=1

    printf '%s\n' "${raw_lines[$i]}"
  done >"$tmp"

  todo_replace_file "$tmp" "$file"
  gum style --foreground="#A6E3A1" "Cleared completed items."
  gum spin --title "Removing…" sleep 0.5
}

todo_edit_item() {
  local file="$1"

  [[ ! -s "$file" ]] && gum style --foreground="#F38BA8" "List is empty." && return

  local -a raw_lines
  mapfile -t raw_lines <"$file"

  local -a item_display item_indices
  todo_build_menu raw_lines item_display item_indices

  todo_menu_has_items item_indices || { gum style --foreground="#F38BA8" "No items to edit yet."; return; }

  local chosen_display
  chosen_display=$(printf '%s\n' "${item_display[@]}" |
    gum choose --header "Select item to edit:")

  [[ -z "$chosen_display" ]] && return

  # A separator resolves to no item, which just backs out
  local chosen_idx=-1
  for i in "${!item_display[@]}"; do
    if (( ${item_indices[$i]} >= 0 )) && [[ "${item_display[$i]}" == "$chosen_display" ]]; then
      chosen_idx="${item_indices[$i]}"
      break
    fi
  done

  [[ $chosen_idx -lt 0 ]] && return

  local original_line="${raw_lines[$chosen_idx]}"
  local original_label prefix
  original_label=$(todo_label "$original_line")
  prefix=$(todo_prefix "$original_line") # indent + "- [ ] " / "- [x] "

  local new_label
  new_label=$(gum input --placeholder "Edit item" --value "$original_label" --width 90)

  # User cancelled or entered empty string
  [[ -z "$new_label" ]] && return

  if [[ "$new_label" != "$original_label" ]]; then
    raw_lines[chosen_idx]="${prefix}${new_label}"

    local tmp
    tmp=$(mktemp)

    printf '%s\n' "${raw_lines[@]}" >"$tmp"

    todo_replace_file "$tmp" "$file"
    # No message
  else
    gum spin --title "No changes made." --spinner="jump" sleep 1.5
  fi
}

todo_action_menu() {
  local file="$1"
  local name
  name=$(basename "$file" .md)

  while true; do
    clear
    todo_show "$file"
    local action
    action=$(gum choose \
      --header "$name list actions:" \
      "Add items" \
      "Add sub-item" \
      "Toggle done / undone" \
      "Edit item" \
      "Clear completed" \
      "Delete list" \
      "Quit")

    case "$action" in
    "Add items")
      todo_add_items "$file"
      ;;
    "Add sub-item")
      todo_add_sub_items "$file"
      ;;
    "Toggle done / undone")
      todo_toggle_items "$file"
      ;;
    "Edit item")
      todo_edit_item "$file"
      ;;
    "Clear completed")
      todo_clear_completed "$file"
      ;;
    "Delete list")
      if gum confirm --default=false "Delete '$name' permanently?"; then
        gum spin --title "Removing…" sleep 1.5
        rm "$file"
        gum style --foreground="#F38BA8" "Deleted $name."
        return 0 # Exit, since file is gone
      fi
      ;;
    "Quit")
      return 0
      ;;
    *) # Catches empty selection from Esc
      return 0
      ;;
    esac
  done
}

# Main function --.

todo() {
  todo_requires || return 1
  mkdir -p "$TODO_DIR"

  local file

  case "${1:-}" in
  --help | -h)
    gum style --border rounded --padding "1 3" --border-foreground="#89B4FA" \
      "$(
        cat <<EOF
todo [name|--list|--help]

  todo                open / create default list in current directory
  todo file_name      open / create 'file_name' list
  todo --list -l      pick a list interactively
  todo --help -h      show this help

Default lists are stored in the current directory.
Named lists are stored as markdown in $TODO_DIR.
EOF
      )"
    return 0
    ;;
  --list | -l)
    file=$(todo_pick_file) || return 0
    ;;
  "")
    file="./todo.md"
    ;;
  *)
    if [[ "$1" == */* ]]; then
      echo "error: list names can't contain '/'" >&2
      return 1
    fi

    file="$TODO_DIR/${1}.md"
    ;;
  esac

  if ! touch "$file"; then
    echo "error: cannot write to '$file'" >&2
    return 1
  fi

  # If file is brand new / empty, directly add items
  if [[ ! -s "$file" ]]; then
    gum style --foreground="#89DCEB" --bold "New list: $(basename "$file" .md)"
    todo_add_items "$file"
  fi

  todo_action_menu "$file"
}

todo "$@"
