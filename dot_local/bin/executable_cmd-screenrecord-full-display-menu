#!/bin/bash

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n $preselect ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n $index ]]; then
      args+=("-c" "$index")
    fi
  fi

  echo -e "$options" | omarchy-launch-walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" "${args[@]}" 2>/dev/null
}

cmd-screenrecord-full-display --stop-recording && exit 0

case $(menu "Screenrecord" "  With no audio\n  With desktop audio\n  With desktop + microphone audio") in
*"With no audio") cmd-screenrecord-full-display ;;
*"With desktop audio") cmd-screenrecord-full-display --with-desktop-audio ;;
*"With desktop + microphone audio") cmd-screenrecord-full-display --with-desktop-audio --with-microphone-audio ;;
*) exit 0 ;;
esac
