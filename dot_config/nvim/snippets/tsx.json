  "Context + Provider": {
    "prefix": "rctx",
    "description": "React context with typed provider",
    "body": [
      "import { createContext, useContext, useState } from 'react';",
      "",
      "interface ${1:Feature}ContextValue {",
      "  $2",
      "}",
      "",
      "const ${1:Feature}Context = createContext<${1:Feature}ContextValue | null>(null);",
      "",
      "export function ${1:Feature}Provider({ children }: { children: React.ReactNode }) {",
      "  $3",
      "  return (",
      "    <${1:Feature}Context.Provider value={{ $4 }}>",
      "      {children}",
      "    </${1:Feature}Context.Provider>",
      "  );",
      "}",
      "",
      "export function use${1:Feature}() {",
      "  const ctx = useContext(${1:Feature}Context);",
      "  if (!ctx) throw new Error('use${1:Feature} must be used within ${1:Feature}Provider');",
      "  return ctx;",
      "}"
    ]
  },

  "Button": {
    "prefix": "rbtn",
    "description": "Typed button component with Tailwind variants",
    "body": [
      "type Variant = 'primary' | 'secondary' | 'ghost' | 'destructive';",
      "",
      "interface ButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {",
      "  variant?: Variant;",
      "  loading?: boolean;",
      "}",
      "",
      "const variants: Record<Variant, string> = {",
      "  primary:     'bg-blue-600 text-white hover:bg-blue-700',",
      "  secondary:   'bg-gray-100 text-gray-900 hover:bg-gray-200',",
      "  ghost:       'text-gray-600 hover:bg-gray-100',",
      "  destructive: 'bg-red-600 text-white hover:bg-red-700',",
      "};",
      "",
      "export function Button({ variant = 'primary', loading, children, className, disabled, ...props }: ButtonProps) {",
      "  return (",
      "    <button",
      "      className={`inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-colors disabled:opacity-50 disabled:pointer-events-none \\${variants[variant]} \\${className ?? ''}`}",
      "      disabled={disabled || loading}",
      "      {...props}",
      "    >",
      "      {loading ? <span className=\"mr-2 h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent\" /> : null}",
      "      {children}",
      "    </button>",
      "  );",
      "}"
    ]
  },

  "Input": {
    "prefix": "rinput",
    "description": "Typed input component with label and error",
    "body": [
      "interface InputProps extends React.InputHTMLAttributes<HTMLInputElement> {",
      "  label?: string;",
      "  error?: string;",
      "}",
      "",
      "export function Input({ label, error, id, className, ...props }: InputProps) {",
      "  return (",
      "    <div className=\"flex flex-col gap-1\">",
      "      {label && <label htmlFor={id} className=\"text-sm font-medium text-gray-700\">{label}</label>}",
      "      <input",
      "        id={id}",
      "        className={`rounded-md border px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-500 \\${error ? 'border-red-500' : 'border-gray-300'} \\${className ?? ''}`}",
      "        {...props}",
      "      />",
      "      {error && <p className=\"text-xs text-red-500\">{error}</p>}",
      "    </div>",
      "  );",
      "}"
    ]
  },

  "cn utility import": {
    "prefix": "cn",
    "description": "clsx + tailwind-merge cn() helper",
    "body": [
      "import { clsx, type ClassValue } from 'clsx';",
      "import { twMerge } from 'tailwind-merge';",
      "",
      "export function cn(...inputs: ClassValue[]) {",
      "  return twMerge(clsx(inputs));",
      "}"
    ]
  },

  "Async data hook": {
    "prefix": "usedata",
    "description": "Generic async data fetching hook",
    "body": [
      "function use${1:Data}<T>(fetcher: () => Promise<T>) {",
      "  const [data, setData] = useState<T | null>(null);",
      "  const [loading, setLoading] = useState(true);",
      "  const [error, setError] = useState<Error | null>(null);",
      "",
      "  useEffect(() => {",
      "    let cancelled = false;",
      "    setLoading(true);",
      "    fetcher()",
      "      .then((d) => { if (!cancelled) setData(d); })",
      "      .catch((e) => { if (!cancelled) setError(e); })",
      "      .finally(() => { if (!cancelled) setLoading(false); });",
      "    return () => { cancelled = true; };",
      "  }, []);",
      "",
      "  return { data, loading, error };",
      "}"
    ]
  },

