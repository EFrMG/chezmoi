{
  "Box size border": {
    "prefix": "bsb",
    "body": ["*, *::before, *::after {", "  box-sizing: border-box;", "}"],
    "description": "Appropriate box sizing"
  },

  "Border radius, Quick!": {
    "prefix": "rad",
    "body": ["border-radius: var(--rad-m);"],
    "description": "Variable included"
  },

  "Mobile query": {
    "prefix": "que",
    "body": ["@media only screen and (max-width: ${1:1200xpx}) {", "  $0", "}"],
    "description": "Mobile query"
  },

  "Debugging border": {
    "prefix": "debug",
    "body": ["  * {", "    border: 1px solid red;", "  }", ""],
    "description": "Debugging border"
  },

  "Full reset": {
    "prefix": "reset",
    "body": [
      "/* Asterisks, Tags and pseudo-elements */",
      "*,",
      "::before,",
      "::after,",
      "::backdrop,",
      "::file-selector-button {",
      "  box-sizing: border-box;",
      "  background-repeat: no-repeat;",
      "}",
      "",
      "  :focus-visible {",
      "    outline: none;",
      "  }",
      "",
      "@media (prefers-reduced-motion: reduce) {",
      "  *,",
      "  ::before,",
      "  ::after,",
      "  ::backdrop,",
      "  ::file-selector-button {",
      "    animation-delay: -1ms !important;",
      "    animation-duration: 1ms !important;",
      "    animation-iteration-count: 1 !important;",
      "    background-attachment: initial !important;",
      "    scroll-behavior: auto !important;",
      "    transition-delay: 0s !important;",
      "    transition-duration: 0s !important;",
      "  }",
      "}",
      "",
      "::before,",
      "::after {",
      "  text-decoration: inherit;",
      "  vertical-align: inherit;",
      "}",
      "",
      "::placeholder {",
      "  opacity: 1;",
      "}",
      "",
      "@supports (not (-webkit-appearance: -apple-pay-button)) /* Not Safari */ or",
      "  (contain-intrinsic-size: 1px) /* Safari 17+ */ {",
      "  ::placeholder {",
      "    color: color-mix(in oklab, currentcolor 50%, transparent);",
      "  }",
      "}",
      "",
      "html {",
      "  -moz-text-size-adjust: none;",
      "  -webkit-text-size-adjust: none;",
      "  text-size-adjust: none;",
      "",
      "  color-scheme: light dark;",
      "  tab-size: 4;",
      "  interpolate-size: allow-keywords;",
      "  overflow-wrap: break-word;",
      "}",
      "",
      "@media (prefers-reduced-motion: no-preference) {",
      "  html {",
      "    scroll-behavior: smooth;",
      "  }",
      "}",
      "",
      "body {",
      "  display: flex;",
      "  flex-direction: column;",
      "  justify-content: space-between;",
      "  margin: 0;",
      "  min-height: 100dvh;",
      "",
      "  font-family: var(",
      "    --ff-base,",
      "    ui-sans-serif,",
      "    system-ui,",
      "    sans-serif,",
      "    \"Apple Color Emoji\",",
      "    \"Segoe UI Emoji\",",
      "    \"Segoe UI Symbol\",",
      "    \"Noto Color Emoji\"",
      "  );",
      "  font-size: var(--fz-base);",
      "  background-color: var(--bkg-clr);",
      "  color: var(--text-clr);",
      "  line-height: var(--ff-base-lh);",
      "",
      "  --body-max-width: 80ch;",
      "}",
      "",
      ":where(h1, h2, h3, h4, h5, h6, p, figure, blockquote, dl, dd) {",
      "  margin-block-end: 0;",
      "}",
      "",
      ":where(h1, h2, h3, h4, h5, h6) {",
      "  text-wrap: balance;",
      "  font-family: var(--ff-heading);",
      "  line-height: var(--ff-heading-lh);",
      "  font-size: inherit;",
      "  font-weight: inherit;",
      "}",
      "",
      ":where(hr) {",
      "  height: 0;",
      "  color: inherit;",
      "  border-top-width: 1px;",
      "}",
      "",
      "abbr:where([title]) {",
      "  -webkit-text-decoration: underline dotted;",
      "  text-decoration: underline dotted;",
      "}",
      "",
      ":where(button, input, select, label, textarea, ::file-selector-button) {",
      "  background-color: transparent;",
      "  opacity: 1;",
      "  border-radius: var(--rad-m);",
      "  font: inherit;",
      "  color: inherit;",
      "  letter-spacing: inherit;",
      "  font-feature-settings: inherit;",
      "  font-variation-settings: inherit;",
      "",
      "  padding: 0.25em 0.375em;",
      "  line-height: var(--ff-heading-lh);",
      "}",
      "",
      "button,",
      "input:where([type=\"button\"], [type=\"reset\"], [type=\"submit\"]),",
      "::file-selector-button {",
      "  appearance: button;",
      "}",
      "",
      ":where(input, select, textarea) {",
      "  display: block;",
      "  min-width: 15ch;",
      "  max-width: 100%;",
      "}",
      "",
      ":where(button),",
      "input[type=\"submit\"] {",
      "  width: max-content;",
      "  cursor: pointer;",
      "  border-radius: var(--rad-m);",
      "}",
      "",
      ":where(dialog) {",
      "  color: unset;",
      "}",
      "",
      "iframe,",
      "img,",
      "input,",
      "select,",
      "textarea {",
      "  height: auto;",
      "  max-height: 100%;",
      "  max-width: 100%;",
      "}",
      "",
      ":where(img, svg, video, canvas, audio, iframe, embed, object) {",
      "  display: block;",
      "  vertical-align: middle;",
      "}",
      "",
      ":where(textarea) {",
      "  resize: vertical;",
      "}",
      "",
      ":where(fieldset) {",
      "  border: none;",
      "  padding: 0;",
      "}",
      "",
      ":where(ul, ol, dl, menu) {",
      "  list-style-type: none;",
      "  margin: 0;",
      "  padding: 0;",
      "}",
      "",
      "  :where(p, span, li:not(.splide__slide), dd, figcaption) {",
      "  /* This one could cause issues */",
      "  max-width: var(--body-max-width);",
      "  text-wrap: pretty;",
      "}",
      "",
      "table {",
      "  border-collapse: collapse;",
      "  text-indent: 0;",
      "  border-color: inherit;",
      "}",
      "",
      "code,",
      "kbd,",
      "samp,",
      "pre {",
      "  font-family: var(--ff-code);",
      "  white-space: pre;",
      "  font-size: 1em;",
      "}",
      "",
      "b,",
      "strong {",
      "  font-weight: bolder;",
      "}",
      "",
      ":where(a) {",
      "  text-decoration: inherit;",
      "  -webkit-text-decoration: inherit;",
      "  text-underline-offset: 5px;",
      "  color: inherit;",
      "}",
      "",
      ":where(a:hover) {",
      "  opacity: 0.93;",
      "}",
      "",
      ":where(a:active) {",
      "  opacity: 0.85;",
      "}",
      "",
      "a,",
      "area,",
      "button,",
      "input,",
      "label,",
      "select,",
      "summary,",
      "textarea,",
      "[tabindex] {",
      "  -webkit-tap-highlight-color: transparent;",
      "  -ms-touch-action: manipulation;",
      "  touch-action: manipulation;",
      "}",
      "",
      ":where(summary) {",
      "  display: list-item;",
      "}",
      "",
      ":where(small) {",
      "  font-size: 80%;",
      "}",
      "",
      ":where(sub, sup) {",
      "  font-size: 75%;",
      "  line-height: 0;",
      "  position: relative;",
      "  vertical-align: baseline;",
      "}",
      "",
      ":where(sub) {",
      "  bottom: -0.25em;",
      "}",
      "",
      ":where(sup) {",
      "  top: -0.5em;",
      "}",
      "",
      ":-moz-focusring {",
      "  outline: auto;",
      "}",
      "",
      ":-moz-ui-invalid {",
      "  box-shadow: none;",
      "}",
      "",
      ":where(progress) {",
      "  vertical-align: baseline;",
      "}",
      "",
      "::-webkit-date-and-time-value {",
      "  min-height: 1lh;",
      "  text-align: inherit;",
      "}",
      "",
      "::-webkit-datetime-edit {",
      "  display: inline-flex;",
      "}",
      "",
      "::-webkit-datetime-edit-fields-wrapper {",
      "  padding: 0;",
      "}",
      "",
      "::-webkit-datetime-edit,",
      "::-webkit-datetime-edit-year-field,",
      "::-webkit-datetime-edit-month-field,",
      "::-webkit-datetime-edit-day-field,",
      "::-webkit-datetime-edit-hour-field,",
      "::-webkit-datetime-edit-minute-field,",
      "::-webkit-datetime-edit-second-field,",
      "::-webkit-datetime-edit-millisecond-field,",
      "::-webkit-datetime-edit-meridiem-field {",
      "  padding-block: 0;",
      "}",
      "",
      "::-webkit-calendar-picker-indicator {",
      "  line-height: 1;",
      "}",
      "",
      "::-webkit-search-decoration {",
      "  -webkit-appearance: none;",
      "}",
      "",
      "::-webkit-inner-spin-button,",
      "::-webkit-outer-spin-button {",
      "  height: auto;",
      "}",
      "",
      "/* Attribute Selectors */",
      "td,",
      "math,",
      "time[datetime*=\":\"] {",
      "  font-variant-numeric: tabular-nums lining-nums;",
      "}",
      "",
      ":where(input[type=\"checkbox\"], input[type=\"radio\"]) {",
      "  cursor: pointer;",
      "  min-width: unset;",
      "}",
      "",
      ":where(input[type=\"color\"]) {",
      "  min-width: 50px;",
      "  min-height: 50px;",
      "  margin: 1rem;",
      "}",
      "",
      ":where(textarea:not([rows])) {",
      "  min-height: 5.5lh;",
      "}",
      "",
      ":where(select:is([multiple], [size])) optgroup {",
      "  font-weight: bolder;",
      "}",
      "",
      ":where(select:is([multiple], [size])) optgroup option {",
      "  padding-inline-start: 20px;",
      "}",
      "",
      "svg:not([fill]) {",
      "  fill: currentColor;",
      "}",
      "",
      "[aria-busy=\"true\"] {",
      "  cursor: progress;",
      "}",
      "",
      "[aria-controls] {",
      "  cursor: pointer;",
      "}",
      "",
      "[aria-disabled=\"true\"],",
      "[disabled] {",
      "  cursor: none;",
      "}",
      "",
      "[aria-hidden=\"false\"][hidden] {",
      "  display: revert !important;",
      "}",
      "",
      "/* Pseudo-classes and Classes */",
      ":where(:first-child) {",
      "  margin-block-start: 0;",
      "}",
      "",
      ":where(:target) {",
      "  scroll-margin-block: 7.75rem;",
      "}",
      "",
      ".sr-only,",
      ".sr-only-focus,",
      "[aria-hidden=\"false\"][hidden] {",
      "  position: absolute !important;",
      "  width: 1px !important;",
      "  height: 1px !important;",
      "  padding: 0 !important;",
      "  margin: -1px !important;",
      "  overflow: hidden !important;",
      "  clip: rect(0, 0, 0, 0) !important;",
      "  white-space: nowrap !important;",
      "  border: 0 !important;",
      "  pointer-events: none !important;",
      "}",
      "",
      ".sr-only-focus:focus,",
      ".sr-only-focus:active,",
      "[aria-hidden=\"false\"][hidden]:focus,",
      "[aria-hidden=\"false\"][hidden]:active {",
      "  position: static !important;",
      "  width: auto !important;",
      "  height: auto !important;",
      "  padding: revert !important;",
      "  margin: revert !important;",
      "  overflow: visible !important;",
      "  clip: auto !important;",
      "  white-space: normal !important;",
      "  border: revert !important;",
      "  pointer-events: auto !important;",
      "}",
      "",
      "/* Media queries */",
      "",
      "@media only screen and (max-width: 900px) {",
      "  body {",
      "    --body-max-width: 100%;",
      "  }",
      "}"
    ],
    "description": "Full reset!"
  },

  "Global variables": {
    "prefix": "globals",
    "body": [
      ":root {",
      "  --ff-base: system-ui;",
      "  --ff-medium: system-ui;",
      "  --ff-bold: system-ui;",
      "  --ff-italic: system-ui;",
      "  --ff-heading: Arial;",
      "  --ff-extra: monospace;",
      "  --ff-extra-bold: monospace;",
      "  --ff-code: monospace, monospace;",
      "",
      "  --fz-base: 1.1875rem;",
      "  --fz-xs: 0.875rem;",
      "  --fz-s: 1.0625rem;",
      "  --fz-ms: 1.25rem;",
      "  --fz-m: 1.375rem;",
      "  --fz-ml: 1.5rem;",
      "  --fz-l: 2rem;",
      "  --fz-xl: 2.5625rem;",
      "  --fz-xxl: 3.25rem;",
      "",
      "  --ff-base-lh: 1.5;",
      "  --ff-heading-lh: 1.2;",
      "",
      "  --body-max-width: 80ch;",
      "  --spacing-xxs: 0.125rem;",
      "  --spacing-xs: 0.25rem;",
      "  --spacing-s: 0.5rem;",
      "  --spacing-ms: 0.75rem;",
      "  --spacing-m: 1rem;",
      "  --spacing-ml: 1.75rem;",
      "  --spacing-l: 2.5rem;",
      "  --spacing-xl: 5rem;",
      "  --spacing-xxl: 8rem;",
      "  --spacing-xxxl: 13rem;",
      "",
      "  --radius-s: 5px;",
      "  --radius-m: 15px;",
      "  --radius-l: 30px;",
      "  --radius-xl: 75px;",
      "",
      "  --pri-1: hsl(162 82.2% 39.6%);",
      "  --pri-2: hsl(162 88.4% 30.4%);",
      "  --pri-3: hsl(162 88.9% 21.2%);",
      "",
      "  --sec-1: hsl(0 94.4% 65.1%);",
      "  --sec-2: hsl(0 73.8% 53.5%);",
      "  --sec-3: hsl(0 65.3% 41.8%);",
      "",
      "  --accent-1: hsl(288 66.7% 57.6%);",
      "  --accent-2: hsl(288 54% 46.1%);",
      "  --accent-3: hsl(288 54.8% 32.9%);",
      "",
      "  --text-clr: hsl(0, 0%, 10%);",
      "  --text-clr-dimish: hsla(0, 0%, 10%, 0.85);",
      "  --text-clr-dim: hsla(0, 0%, 10%, 0.7);",
      "",
      "  --bkg-clr: hsl(0, 0%, 95%);",
      "",
      "  --trs-xs: 135ms ease-in-out;",
      "  --trs-s: 230ms ease-in-out;",
      "  --trs-m: 500ms ease-in-out;",
      "  --trs-l: 1075ms ease-in-out;",
      "  --trs-in: 350ms cubic-bezier(0.11, 0, 0.5, 0);",
      "  --trs-in-long: 1075ms cubic-bezier(0.11, 0, 0.5, 0);",
      "  --trs-out: 500ms cubic-bezier(0.5, 1, 0.89, 1);",
      "  --trs-out-long: 900ms cubic-bezier(0.5, 1, 0.89, 1);",
      "  --trs-out-longer: 1450ms cubic-bezier(0.5, 1, 0.89, 1);",
      "  --trs-back-in: 500ms",
      "    linear(",
      "      0,",
      "      -0.004 6.9%,",
      "      -0.019 13.8%,",
      "      -0.11 37.6%,",
      "      -0.131 46.7%,",
      "      -0.13 51.8%,",
      "      -0.118 56.5%,",
      "      -0.095 60.9%,",
      "      -0.06 65.1%,",
      "      0.002 70.1%,",
      "      0.081 74.8%,",
      "      0.301 83.7%,",
      "      0.607 92.1%,",
      "      1",
      "    );",
      "  --trs-back-in-short: 375ms",
      "    linear(",
      "      0,",
      "      -0.004 6.9%,",
      "      -0.019 13.8%,",
      "      -0.11 37.6%,",
      "      -0.131 46.7%,",
      "      -0.13 51.8%,",
      "      -0.118 56.5%,",
      "      -0.095 60.9%,",
      "      -0.06 65.1%,",
      "      0.002 70.1%,",
      "      0.081 74.8%,",
      "      0.301 83.7%,",
      "      0.607 92.1%,",
      "      1",
      "    );",
      "  --trs-back-in-out: 500ms",
      "    linear(",
      "      0,",
      "      -0.004 4.8%,",
      "      -0.02 9.3%,",
      "      -0.124 26.1%,",
      "      -0.126 30.3%,",
      "      -0.104 33.9%,",
      "      -0.026 38.7%,",
      "      0.111 43.1%,",
      "      0.301 47%,",
      "      0.819 55.3%,",
      "      0.969 59.2%,",
      "      1.07 63.5%,",
      "      1.118 67.8%,",
      "      1.127 72.8%,",
      "      1.108 77.4%,",
      "      1.019 90.9%,",
      "      1.004 95.3%,",
      "      1",
      "    );",
      "  --trs-back-in-out-short: 245ms",
      "    linear(",
      "      0,",
      "      -0.004 4.8%,",
      "      -0.02 9.3%,",
      "      -0.124 26.1%,",
      "      -0.126 30.3%,",
      "      -0.104 33.9%,",
      "      -0.026 38.7%,",
      "      0.111 43.1%,",
      "      0.301 47%,",
      "      0.819 55.3%,",
      "      0.969 59.2%,",
      "      1.07 63.5%,",
      "      1.118 67.8%,",
      "      1.127 72.8%,",
      "      1.108 77.4%,",
      "      1.019 90.9%,",
      "      1.004 95.3%,",
      "      1",
      "    );",
      "  --trs-back-out: 500ms cubic-bezier(0.7, 1.6, 0.63, 1);",
      "  --trs-bounce: 800ms",
      "    linear(",
      "      0,",
      "      0.269 10.8%,",
      "      0.531 23.9%,",
      "      0.793 39.6%,",
      "      0.953 52.2%,",
      "      1 57.7%,",
      "      0.966 64.3%,",
      "      0.955 71%,",
      "      0.994 91.1%,",
      "      1",
      "    );",
      "}",
      "",
      "/* Elements */",
      "",
      "@media (prefers-color-scheme: dark) {",
      "  :root {",
      "    --text-clr: hsl(0, 0%, 90%);",
      "    --text-clr-dimish: hsla(0, 0%, 90%, 0.85);",
      "    --text-clr-dim: hsla(0, 0%, 90%, 0.7);",
      "    --bkg-clr: hsl(0, 0%, 10%);",
      "  }",
      "}",
      "",
      "@media (prefers-color-scheme: light) {",
      "  :root {",
      "  }",
      "}",
      "",
      "body.dark-theme {",
      "  :root {",
      "  }",
      "}",
      "",
      "body.light-theme {",
      "  :root {",
      "  }",
      "}",
      "",
      "::selection {",
      "}",
      "",
      "nav {",
      "  font-family: var(--ff-extra);",
      "}",
