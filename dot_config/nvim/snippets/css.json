      "  gap: --spacing(--value(number));",
      "}",
      "",
      "@layer components {",
      "  .card {",
      "    @apply bg-white rounded-lg p-5 shadow-xl;",
      "  }",
      "",
      "  .btn-click-soft {",
      "    @apply active:scale-98 transition-transform ease-in duration-85;",
      "  }",
      "}"
    ],
    "description": "Tailwind general"
  }
}
