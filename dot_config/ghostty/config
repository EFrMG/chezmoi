# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# General
# TODO: Order entries in this new menu
app-notifications = no-clipboard-copy
confirm-close-surface=false

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 12
font-synthetic-style = false

# Window
window-theme = ghostty
resize-overlay = never
gtk-toolbar-style = flat
window-padding-x = 8
window-padding-color = extend
bell-features = no-title
unfocused-split-opacity = 0.93
# scrollback-limit = 500000
quit-after-last-window-closed = false
quit-after-last-window-closed-delay = 3m

# Cursor styling
cursor-style = "block"
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = true
mouse-shift-capture = true
# right-click-action = ignore
cursor-opacity = 0.93

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

keybind = ctrl+shift+r=prompt_surface_title
keybind = ctrl+tab=previous_tab
# It does not work!
keybind = ctrl+shift+tab=next_tab
keybind = ctrl+shift+q=reload_config
keybind = ctrl+shift+space>c=new_tab
keybind = alt+space=new_tab
# keybind = ctrl+alt+space=new_tab
# Note: we still have alt+<arrow_keys>
keybind = ctrl+shift+left=goto_split:previous
keybind = alt+shift+left=previous_tab
keybind = ctrl+alt+shift+left=move_tab:-1
keybind = ctrl+shift+right=goto_split:next
keybind = alt+shift+right=next_tab
keybind = ctrl+alt+shift+right=move_tab:1

# Define the prefix trigger
keybind = ctrl+shift+space>ctrl+shift+space=text:\x00

keybind = ctrl+shift+space>h=new_split:down
keybind = ctrl+shift+space>v=new_split:right
keybind = ctrl+shift+space>x=close_surface
keybind = ctrl+shift+space>r=prompt_tab_title
keybind = ctrl+shift+space>o=goto_split:next
keybind = ctrl+shift+space>shift+o=goto_split:previous

keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
keybind = alt+0=last_tab
keybind = alt+digit_1=goto_tab:1
keybind = alt+digit_2=goto_tab:2
keybind = alt+digit_3=goto_tab:3
keybind = alt+digit_4=goto_tab:4
keybind = alt+digit_5=goto_tab:5
keybind = alt+digit_6=goto_tab:6
keybind = alt+digit_7=goto_tab:7
keybind = alt+digit_8=goto_tab:8
keybind = alt+digit_9=goto_tab:9
keybind = alt+digit_0=last_tab

# Slowdown mouse scrolling
mouse-scroll-multiplier = 3

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

