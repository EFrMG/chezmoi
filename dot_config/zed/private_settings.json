// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "colorize_brackets": true,
  "hover_popover_hiding_delay": 140,
  "hover_popover_delay": 410,
  "auto_signature_help": false,
  "fast_scroll_sensitivity": 5.0,
  "horizontal_scroll_margin": 8.0,
  "which_key": {
    "enabled": true,
  },
  "hide_mouse": "never",
  "language_models": {
    "opencode": {
      "show_zen_models": false,
      "show_go_models": false,
    },
  },
  "agent_servers": {
    },
  "drag_and_drop_selection": {
    "delay": 200,
    "enabled": true,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "ui_font_size": 19.0,
  "buffer_font_size": 20,
  "bottom_dock_layout": "contained",
  "icon_theme": "Catppuccin Mocha",
  "theme": "Catppuccin Mocha",
  "agent_buffer_font_size": 18.0,
  "calls": {
    "mute_on_join": false,
  },
  "collaboration_panel": {
    "dock": "right",
    "button": true,
  },
  "git_panel": {
    "fallback_branch_name": "master",
    "dock": "right",
    "collapse_untracked_diff": false,
    "sort_by_path": true,
    "status_style": "icon",
  },
  "outline_panel": {
    "dock": "right",
    "indent_size": 18.0,
    "button": true,
  },
  "zoomed_padding": false,
  "tab_bar": {
    "show_nav_history_buttons": true,
    "show": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
  },
  "search_wrap": true,
  "lsp_highlight_debounce": 300,
  "diagnostics": {
    "lsp_pull_diagnostics": {
      "debounce_ms": 300,
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 500,
    },
  },
  "agent_ui_font_size": 21.0,
  "image_viewer": {
    "unit": "decimal",
  },
  "extend_comment_on_newline": false,
  "inlay_hints": {
    "edit_debounce_ms": 500,
    "enabled": false,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "indent_aware",
    "line_width": 2,
    "active_line_width": 2,
  },
  "tab_size": 2,
  "relative_line_numbers": "disabled",
  "snippet_sort_order": "top",
  "minimum_contrast_for_highlights": 68.0,
  "unnecessary_code_fade": 0.3,
  "cursor_blink": false,
  "when_closing_with_no_tabs": "keep_window_open",
  "vim": {
    "use_system_clipboard": "on_yank",
    "highlight_on_yank_duration": 230,
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": false
  },
  "vim_mode": true,
  "restore_on_file_reopen": false,
  "completions": {
    "lsp_fetch_timeout_ms": 100,
    "words_min_length": 3,
    "words": "fallback",
    "lsp": true,
    "lsp_insert_mode": "replace_suffix",
  },
  "ensure_final_newline_on_save": true,
  "scroll_sensitivity": 1.5,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "minimap": {
    "show": "never"
  },
  "base_keymap": "VSCode",
  "languages": {
    "HTML": {
      "show_edit_predictions": true,
      "tab_size": 2,
    },
    "CSS": {
      "tab_size": 2,
    },
    "JavaScript": {
      "show_edit_predictions": false,
      "tab_size": 2,
    },
    "Python": {
      "show_edit_predictions": true,
      "tab_size": 4,
    },
  },
  "toolbar": {
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": false,
    "code_actions": true,
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "ollama": {
      "model": "codegemma:2b",
      "prompt_format": "infer"
    },
    "provider": "zed",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },
  "project_panel": {
    "hide_hidden": true,
    "hide_gitignore": false,
    "indent_size": 16.0,
    "starts_open": false,
    "default_width": 240.0,
    "dock": "left",
  },
  "agent": {
    "favorite_models": [],
    "max_content_width": 1350.0,
    "inline_assistant_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "enable_thinking": false,
      "provider": "opencode",
      "model": "free/big-pickle",
    },
    "model_parameters": [],
  },
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 0.9,
  },
  "telemetry": {
    "metrics": false,
  },
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_weight": 350.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_weight": 300.0,
  "buffer_font_features": {
    "calt": true,
  },
  "buffer_line_height": {
    "custom": 1.45,
  },
  "current_line_highlight": "all",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "gutter": {
    "bookmarks": true,
    "line_numbers": true,
    "runnables": true,
    "breakpoints": true,
    "folds": true,
    "min_line_number_digits": 1,
  },
  "inline_code_actions": true,
  "vertical_scroll_margin": 4.0,
  "use_smartcase_search": true,
  "tabs": {
    "close_position": "right",
    "git_status": true,
    "file_icons": true,
    "show_close_button": "hover",
    "show_diagnostics": "all",
  },
  // Soft wrap lines that overflow the editor.
  //      "soft_wrap": "editor_width",
  // Soft wrap lines at the preferred line length.
  //      "soft_wrap": "preferred_line_length",
  "soft_wrap": "editor_width",
  // The column at which to soft-wrap lines, for buffers where soft-wrap
  // is enabled.
  "preferred_line_length": 80,
  "auto_indent_on_paste": true,
  "terminal": {
    "show_count_badge": true,
    "keep_selection_on_copy": false,
    "button": true,
    "blinking": "off",
    "cursor_shape": "bar",
    "copy_on_select": true,
    "line_height": {
      "custom": 1.25,
    },
    "font_size": 19.0,
    "font_weight": 400.0,
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": false,
      "delay_ms": 5000,
    },
  },
  "format_on_save": "on",
  "scrollbar": {
    "axes": {
      "vertical": true,
      "horizontal": false,
    },
  },
}
