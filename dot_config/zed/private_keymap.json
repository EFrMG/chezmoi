// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      // "ctrl-shift-a": "editor::ToggleComments",
      "ctrl-shift-alt-f": "editor::Format",
      "ctrl-shift-q": "editor::DeleteLine",
      "ctrl-alt-a": "editor::SelectAllMatches",
      "alt-h": "editor::MoveToBeginningOfLine",
      "alt-l": "editor::MoveToEndOfLine"
    }
  },
  {
    "context": "os != macos && Editor && (edit_prediction && (showing_completions || in_leading_whitespace))",
    "bindings": {
      // alt-l is provided as an alternative to tab/alt-tab. and will be displayed in the UI. This
      // is because alt-tab may not be available, as it is often used for window switching on Linux
      // and Windows.
      "alt-e": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-shift-e": "zed::Extensions",
      "ctrl-alt-x": "workspace::ToggleLeftDock",
      "ctrl-shift-x": "workspace::ToggleBottomDock",
      "ctrl-alt-c": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward"
    }
  },
  {
    "context": "Editor && !menu",
    "bindings": {
      "ctrl-c": "editor::Copy", // vim default: return to normal mode
      "ctrl-x": "editor::Cut", // vim default: decrement
      "ctrl-s": "workspace::Save", // vim default: show signature
      "ctrl-a": "editor::SelectAll" // vim default: increment
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "g s": "vim::PushAddSurrounds"
    }
  },
  {
    "bindings": {
      "ctrl-shift-w": null
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-w": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-w": null
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-w": null
    }
  },
  {
    "bindings": {
      "ctrl-alt-m": "workspace::MoveItemToPaneInDirection"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-n": "workspace::NewFile"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-shift-n": "project_panel::NewFile"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-n": null
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-n": null
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-k": null
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-k": null
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-alt-y": null
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-j": "terminal_panel::Toggle"
    }
  },
  {
    "bindings": {
      "ctrl-q": null
    }
  },
  {
    "bindings": {
      "ctrl-shift-exclamdown": "editor::ToggleRelativeLineNumbers"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-j": "terminal_panel::Toggle"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "space w d": "pane::SplitDown"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "space w d": "pane::SplitDown"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "space w d": "pane::SplitDown"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "space p d": "pane::SplitDown"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "space w d": "pane::SplitDown"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-k w": [
        "pane::CloseAllItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "!Editor && !Terminal",
    "bindings": {
      "space w d": "pane::CloseActiveItem"
    }
  },
  {
    "context": "!Editor && !Terminal",
    "unbind": {
      "space w q": "pane::CloseActiveItem"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "space b a": "pane::CloseAllItems"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "space b c": [
        "pane::CloseCleanItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-k u": [
        "pane::CloseCleanItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "space b o": [
        "pane::CloseOtherItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-alt-t": [
        "pane::CloseOtherItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "space b l": [
        "pane::CloseItemsToTheLeft",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-k e": [
        "pane::CloseItemsToTheLeft",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "space b r": [
        "pane::CloseItemsToTheRight",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-k t": [
        "pane::CloseItemsToTheRight",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-k ctrl-b": "workspace::CloseAllItemsAndPanes"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-k ctrl-w": "workspace::CloseAllItemsAndPanes"
    }
  }
]
