{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.weather"
        },
        {
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        }
      ],
      "left": [
        {
          "id": "francisco.menu"
        },
        {
          "id": "francisco.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy-watch-clipboard"
        },
        {
          "id": "francisco.cpu-temperature"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "bottom",
    "transparent": false
  },
  "cloneSourceRestores": [
    "francisco.emojis",
    "francisco.menu",
    "francisco.clipboard"
  ],
  "disabledPlugins": [
    "omarchy.emojis",
    "omarchy.menu",
    "omarchy.clipboard"
  ],
  "idle": {
    "lock": 480,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "francisco.emojis"
    },
    {
      "id": "omarchy-unicode-picker"
    },
    {
      "id": "francisco.clipboard"
    }
  ],
  "version": 1
}
